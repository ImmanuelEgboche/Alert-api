# Application
APP_NAME=crypto-alert-api
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cryptoalert
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
# Signs webhooks. Production refuses this placeholder or anything under 32 chars.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=your-secret-key-change-in-production
API_KEY_LENGTH=32

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
REGISTER_RATE_LIMIT_PER_HOUR=5

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_SECONDS=2
WEBHOOK_WORKERS=10

# WebSocket Exchanges
BINANCE_WS_URL=wss://stream.binance.com:9443
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
KRAKEN_WS_URL=wss://ws.kraken.com
# Tradable-symbol list (alert validation), refreshed every SYMBOL_REFRESH_SECONDS
BINANCE_REST_URL=https://api.binance.com
SYMBOL_REFRESH_SECONDS=3600

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
# Bearer token for GET /api/v1/metrics; unset = endpoint disabled.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# Performance
MAX_ALERTS_PER_USER=100
MAX_WEBHOOK_QUEUE_SIZE=10000
ALERT_CLEANUP_INTERVAL_SECONDS=60

# Production only (docker-compose.prod.yml requires these; the dev stack ignores them)
# Use URL-safe characters: the password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
